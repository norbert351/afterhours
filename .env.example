# =============================================================================
# AfterHours environment — multi-chain (Solana + BNB Smart Chain)
# All values are OPTIONAL unless noted; the app degrades to labeled/keyless
# sources by default. NEVER commit a real .env (it is gitignored).
# Copy to .env and fill in only the chain(s) you want to run.
# =============================================================================

# --- server ---
PORT=8090
AH_DB_PATH=data/afterhours.db          # persistent ledger (node:sqlite WAL)
AH_SEED_USD=10000                      # paper account seed
AH_CACHE_TTL_MS=30000

# --- reference / market-hours (shared, both chains) ---
TWELVEDATA_API_KEY=demo                # NYSE reference anchor (free "demo" = AAPL only)
AH_REFERENCE_SYMBOLS=AAPL,MSFT,NVDA,SPY
PYTH_API_KEY=                          # Solana: live Pyth gap prices (401 without it)

# --- auth (optional) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# =============================================================================
# BNB SMART CHAIN (current hackathon track) — chain 56, SPOT ONLY
# =============================================================================
# Binance Web3 API (free key at web3.binance.com dev-portal). Gates the
# RWA Data / Market / Trading / Transaction modules. Unset => those surfaces
# are flagged "not configured", never fabricated.
AH_BNB_WEB3_KEY=
AH_BNB_WEB3_SECRET=
# Exec + agent wallet (BSC mainnet). Required ONLY for live execution + the
# agent wallet surface. The Transaction-API dry-run never needs funding.
AH_BNB_EXEC_PRIVATE_KEY=
AH_BNB_EXEC_MAX_USD=0.50               # hard server-side cap per live swap
# Optional: override the exec proof log / agent action log paths (defaults live in data/).
# AH_BNB_EXEC_LOG=
# AH_BNB_AGENT_LOG=

# =============================================================================
# SOLANA (original build / Stocklana) — Solana mainnet
# =============================================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=                    # base58 secret for the execution wallet
AH_LIVE_EXEC=0                         # 1 = enable real capped swaps (Jupiter /swap/v1)
AH_LIVE_EXEC_USD=0.60
# Weekend Gap Vault (real capital, hard-capped). AH_VAULT_EXEC=1 enables real buys.
AH_VAULT_EXEC=0
AH_VAULT_CAP_USD=0.25
AH_VAULT_MAX_POSITIONS=1
AH_VAULT_MIN_VOL_USD=5000
AH_VAULT_AUTORUN=0

# =============================================================================
# AGENT (Sleep Mode / NL strategy) — optional
# =============================================================================
AH_QWEN_KEY=
AH_QWEN_BASE=
AH_QWEN_MODEL=
AH_SLEEP_ARMED=0
AH_SLEEP_VENUES=
AH_SLEEP_MS=600000
AH_INJECT_TOKEN=
