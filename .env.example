# AfterHours environment — all optional; app works with verified no-key sources
# on defaults. Set these to enable the keyed layers.

# Port for the API + frontend
PORT=8080

# TwelveData API key (default "demo" works for AAPL/MSFT/NVDA reference prices).
# Get your own free key: https://twelvedata.com/apikey
TWELVEDATA_API_KEY=demo

# NYSE tickers used as the market-hours-aware "frozen reference" anchor
# (free demo key serves ONE symbol: AAPL; a real key unlocks more)
AH_REFERENCE_SYMBOLS=AAPL

# Pyth Hermes key — enables LIVE latest prices for the 5 verified AAPL feeds
# (fetches 401 without it). Free via the Pyth bounty / pyth.network.
PYTH_API_KEY=

# v2 persistent store path + paper account seed (default data/afterhours.db, $10k)
AH_DB_PATH=
AH_SEED_USD=10000

# Cache TTL for upstream sponsor API calls (ms)
AH_CACHE_TTL_MS=30000
# Privy (managed wallet auth) — get an App ID free at privy.io. Until set, the
# navbar "Connect wallet" falls back to the native self-custody Solana sign-in.
PRIVY_APP_ID=

# REAL execution (opt-in). Set to 1 to let the strategy buy the deepest live
# on-chain gap tokenized equity through the wallet (very small, capped).
# Routes via Jupiter /swap/v1 on api.jup.ag (quote-api.jup.ag is retired).
AH_LIVE_EXEC=0
AH_LIVE_EXEC_USD=5

# Weekend Gap Vault — real execution needs AH_VAULT_EXEC=1 + a funded wallet.
AH_VAULT_EXEC=0
AH_VAULT_CAP_USD=0.25
AH_VAULT_MAX_POSITIONS=1
AH_VAULT_MIN_VOL_USD=5000
AH_VAULT_AUTORUN=1
