{
  "name": "afterhours",
  "version": "0.1.0",
  "description": "AfterHours — real-time on-chain equity intelligence & market-hours dislocation engine (Solana + BNB, verified data)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/index.js",
    "dev": "node --watch --dns-result-order=ipv4first src/index.js",
    "verify": "node --dns-result-order=ipv4first scripts/verify-data.js",
    "test": "node --test --dns-result-order=ipv4first test/*.test.mjs"
  },
  "main": "src/index.js",
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "^0.2.71-alpha",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "express": "^4.19.2"
  }
}
